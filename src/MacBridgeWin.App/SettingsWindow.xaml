<Window x:Class="MacBridgeWin.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MacBridgeWin.App.Controls"
        Title="MacBridgeWin Settings"
        Width="980"
        Height="620"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MacBridgeWin"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="Settings"
                       Margin="0,4,0,18"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Content="Enable macOS-style keyboard mappings"
                              IsChecked="{Binding KeyboardMappingsEnabled}"
                              Margin="0,0,0,12" />
                    <CheckBox Grid.Row="1"
                              Content="Enable mouse gestures"
                              IsChecked="{Binding MouseGesturesEnabled}"
                              Margin="0,0,0,12" />
                    <CheckBox Grid.Row="2"
                              Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              Margin="0,0,0,24" />

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Configuration file"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBox Text="{Binding ConfigurationPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 BorderThickness="1"
                                 Padding="8" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Keyboard">
                <DataGrid x:Name="KeyboardMappingsGrid"
                          ItemsSource="{Binding KeyboardMappings}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Margin="0,16,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding SourceShortcut, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" />
                        <DataGridTextColumn Header="Target"
                                            Binding="{Binding TargetShortcut, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Mouse">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#D8DDE8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Applications"
                                       FontWeight="SemiBold"
                                       Margin="12,10,12,8" />
                            <ListBox x:Name="GestureScopesList"
                                     ItemsSource="{Binding GestureScopes}"
                                     SelectedItem="{Binding SelectedGestureScope}"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayProcess}"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2"
                            BorderBrush="#D8DDE8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="12,10,12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Name"
                                               FontSize="12"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    <TextBox Text="{Binding SelectedGestureScope.Name, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="5" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="0,0,10,0">
                                    <TextBlock Text="Process"
                                               FontSize="12"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    <TextBox Text="{Binding SelectedGestureScope.ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="5" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <TextBlock Text="Threshold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBox Text="{Binding SelectedGestureScope.MouseGestureThresholdPixels, UpdateSourceTrigger=PropertyChanged}"
                                             Width="64"
                                             Padding="5" />
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="ProfileGestureActionsGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding SelectedGestureScope.MouseGestures}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Enabled"
                                                            Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="72" />
                                    <DataGridComboBoxColumn Header="Modifier"
                                                            SelectedValueBinding="{Binding ModifierKey, UpdateSourceTrigger=PropertyChanged}"
                                                            DisplayMemberPath="Name"
                                                            SelectedValuePath="Modifier"
                                                            Width="150">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource"
                                                        Value="{Binding Source={x:Static controls:GestureOptionsProvider.ModifierOptions}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource"
                                                        Value="{Binding Source={x:Static controls:GestureOptionsProvider.ModifierOptions}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridTemplateColumn Header="Gesture"
                                                            Width="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:GesturePreviewControl Gesture="{Binding Gesture}"
                                                                                    Width="76"
                                                                                    Height="38" />
                                                    <TextBlock Text="{Binding Gesture}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Gesture"
                                                          ItemsSource="{Binding Source={x:Static controls:GestureOptionsProvider.GestureOptions}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal">
                                                                <controls:GesturePreviewControl Gesture="{Binding Gesture}"
                                                                                                Width="76"
                                                                                                Height="38" />
                                                                <StackPanel VerticalAlignment="Center"
                                                                            Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding Name}" />
                                                                    <TextBlock Text="{Binding Gesture}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridComboBoxColumn Header="Action"
                                                            SelectedValueBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                            DisplayMemberPath="Name"
                                                            SelectedValuePath="Action"
                                                            Width="2*">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource"
                                                        Value="{Binding Source={x:Static controls:GestureActionOptionsProvider.Options}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="ItemsSource"
                                                        Value="{Binding Source={x:Static controls:GestureActionOptionsProvider.Options}}" />
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridCheckBoxColumn Header="Cursor"
                                                            Binding="{Binding ShowCursor, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="64" />
                                    <DataGridTextColumn Header="Note"
                                                        Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button Content="+ App"
                                Width="76"
                                Margin="0,0,8,0"
                                Click="AddGestureScopeButton_Click" />
                        <Button Content="- App"
                                Width="76"
                                Click="RemoveGestureScopeButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button Content="+ Action"
                                Width="88"
                                Margin="0,0,8,0"
                                Click="AddProfileGestureButton_Click" />
                        <Button Content="- Action"
                                Width="88"
                                Click="RemoveProfileGestureButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <TextBlock x:Name="SaveStatusText"
                       Text="Saved"
                       Visibility="Collapsed"
                       VerticalAlignment="Center"
                       Foreground="ForestGreen"
                       Margin="0,0,12,0" />
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button Content="Import"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="ImportButton_Click" />
            <Button Content="Export"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="ExportButton_Click" />
            <Button Content="Close"
                    Width="88"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
