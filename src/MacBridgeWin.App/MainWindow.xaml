<Window x:Class="MacBridgeWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacBridgeWin"
        Height="240"
        Width="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="MacBridgeWin is running from the system tray."
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12" />
            <TextBlock Text="Open Settings from the tray icon to manage foundation options."
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
